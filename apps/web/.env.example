# Base URL of the Laravel API host (root — NOT including /api).
# Fortify routes live at the root (POST /login, /register, ...); the API is under /api.
# Use http://localhost (NOT 127.0.0.1): Sanctum session cookies are scoped to
# SESSION_DOMAIN=localhost and won't round-trip to 127.0.0.1.
VITE_API_URL=http://localhost:8001
