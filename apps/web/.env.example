# Web SPA environment. Copy to `.env` to override the defaults. Vite only exposes `VITE_`-prefixed vars.
#
# Bare host of the Laravel API — NO trailing slash and NO `/api` suffix (the client adds `/api/...`
# and hits Fortify actions at the root, e.g. `/login`). Port 8000 matches `pnpm dev:api`
# (`php artisan serve`). Use `localhost` (NOT 127.0.0.1) so the Sanctum session cookie, scoped to
# `SESSION_DOMAIN=localhost`, round-trips. The app defaults to this value when unset.
VITE_API_URL=http://localhost:8000
