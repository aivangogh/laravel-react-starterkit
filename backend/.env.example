APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# --- API host + port (single source of truth for the backend origin) -----------------------
# `php artisan serve` / `pnpm dev:api` read SERVER_HOST + SERVER_PORT natively. Change the port
# here and everything follows: APP_URL below interpolates it, the SPA derives VITE_API_URL from
# this file (apps/web/vite.config.ts), and `pnpm run setup` prints the right URLs. Use `localhost`
# (NOT 127.0.0.1) so Sanctum's localhost-scoped session cookie round-trips to the SPA.
SERVER_HOST=localhost
SERVER_PORT=8000
APP_URL="http://${SERVER_HOST}:${SERVER_PORT}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=starterkit
DB_USERNAME=starterkit
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# --- SPA (decoupled React frontend) — Sanctum cookie auth ------------------------------------
# Origin(s) of the SPA allowed to call the API with credentials. Drives BOTH CORS allowed_origins
# and Sanctum's stateful domains (config/cors.php + config/sanctum.php derive from this — nothing
# to hand-sync). Comma-separate to allow several origins, e.g. dev + prod. No trailing slash:
#   FRONTEND_URL=http://localhost:5174,https://app.example.com
FRONTEND_URL=http://localhost:5174

# Optional override for Sanctum's stateful domains (host[:port], comma-separated). Leave unset:
# they're derived from FRONTEND_URL + APP_URL + loopback. Set only for hosts those don't imply.
# SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
