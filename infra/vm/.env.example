# Copy to .env on the VM and fill in. Consumed by docker-compose.prod.yml;
# APP_* / FRONTEND_URL / SESSION_DOMAIN are passed straight into the Laravel
# container via env_file.

# php artisan key:generate --show  (run locally, paste result)
APP_KEY=

# Your Cloudflare zone, e.g. example.com
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
SESSION_DOMAIN=.example.com

# Postgres (containers on the same box; any strong password)
DB_DATABASE=starterkit
DB_USERNAME=starterkit
DB_PASSWORD=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> create ->
# copy the token from the docker install command)
TUNNEL_TOKEN=
