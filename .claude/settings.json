{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm type-check)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:down)",
      "Bash(pnpm db:logs)",
      "Bash(pnpm db:reset)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm -w *)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(docker compose --env-file ./backend/.env ps)",
      "Bash(docker compose --env-file ./backend/.env logs:*)",
      "Bash(docker compose --env-file ./backend/.env up -d *)",
      "Bash(docker compose --env-file ./backend/.env down)",
      "Bash(docker compose ps)",
      "Bash(docker ps)",
      "Bash(composer install)",
      "Bash(composer update:*)",
      "Bash(composer require:*)",
      "Bash(composer test)",
      "Bash(composer dump-autoload)",
      "Bash(composer config:*)",
      "Bash(php -v)",
      "Bash(php -m)",
      "Bash(php artisan *)",
      "Bash(./vendor/bin/pint *)",
      "Bash(./vendor/bin/pest *)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Read(./backend/.env)",
      "Read(./apps/web/.env)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
